# Backend configuration. Copy to .env and edit.

# SQLAlchemy DB URL. Default is SQLite under data/. For Postgres:
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/reviews
# DATABASE_URL=sqlite:///./data/reviews.db

# Scraper settings
SCRAPE_HEADLESS=true
SCRAPE_MAX_PAGES_PER_PROPERTY=20
SCRAPE_PAGE_DELAY_SECONDS=1.5

# Optional LLM pass on top of the keyword classifier.
ENABLE_LLM_TOPICS=false
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Comma-separated list of allowed CORS origins for the dashboard.
CORS_ORIGINS=["http://localhost:5173","http://localhost:4173"]
